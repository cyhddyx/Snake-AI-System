<mxfile host="app.diagrams.net" agent="Codex">
  <diagram id="submission-review-flow-paper" name="投稿审核模块流程图（论文版）">
    <mxGraphModel dx="1488" dy="782" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v_start" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;strokeWidth=2;" value="开始" vertex="1">
