        </mxCell>
        <mxCell id="v_open" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;strokeWidth=2;" value="编辑进入投稿审核页面" vertex="1">
