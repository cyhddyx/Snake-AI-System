        <mxCell id="v_list_api" parent="1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#ffffff;fontColor=#000000;strokeWidth=2;" value="调用 GET /species-submissions?status=pending&#xa;获取待审投稿列表" vertex="1">
